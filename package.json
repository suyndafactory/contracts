{
  "name": "@suynda/contracts",
  "version": "0.9.0",
  "description": "Shared structural contracts for the Suynda system — enums, modules, events, envelope schema, capabilities, error codes, metered-operation keys. No commercial values.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data/*": "./data/*",
    "./schema/*": "./schema/*"
  },
  "files": [
    "dist",
    "data",
    "schema"
  ],
  "scripts": {
    "generate:schema": "node scripts/generate-schema.mjs",
    "prebuild": "node scripts/generate-schema.mjs",
    "build": "tsc",
    "verify": "npm run build && node scripts/verify-v0.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "license": "UNLICENSED",
  "private": true
}
