{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suynda.com/schemas/contributor-context.schema.json",
  "title": "Suynda ContributorContext",
  "description": "Module-facing contributor context. Closed shape: unknown fields are rejected. Topology is not authorization. context_ref may be null (unipersonal / no grupo).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_ref",
    "documento",
    "tenants",
    "entity_version",
    "resolved_at"
  ],
  "properties": {
    "context_ref": {
      "type": ["string", "null"],
      "description": "Stable group id; null = single-space context. Not a global tax identity."
    },
    "documento": {
      "description": "Identity reference, never a global key.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tipo", "pais", "valor"],
          "properties": {
            "tipo": { "type": "string", "minLength": 1 },
            "pais": { "type": "string", "minLength": 1 },
            "valor": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "tenants": {
      "type": "array",
      "minItems": 1,
      "description": "Spaces that belong to the context now. Presence is not a grant.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tenant_id"],
        "properties": {
          "tenant_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "entity_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic context version"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 instant of the read"
    }
  }
}
